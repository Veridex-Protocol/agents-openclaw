{
  "name": "@veridex/agents-openclaw",
  "version": "0.1.5",
  "description": "OpenClaw/Pi compatibility bridge for the Veridex Agent Runtime — skill importer, context-file importer, ACP bridge, session/event translator",
  "license": "MIT",
  "author": "Veridex Team",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@veridex/agents": "0.1.8"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@veridex/agents": "0.1.8",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "veridex",
    "agents",
    "openclaw",
    "pi",
    "bridge",
    "interop",
    "skills",
    "context-files"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/agents-openclaw.git"
  },
  "homepage": "https://github.com/Veridex-Protocol/agents-openclaw#readme",
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/agents-openclaw/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
